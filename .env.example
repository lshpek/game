# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. Never commit a populated `.env`.
# Paths are relative to the `backend/` directory (where the API runs).
# ---------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=604800

# Development: sqlite:///./app.db   Production: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./app.db
DB_ECHO=false
AUTO_MIGRATE=true
AUTO_SEED=true

# --- Telegram -------------------------------------------------------------
BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=CHANGE_ME
MINI_APP_SHORT_NAME=numora
TELEGRAM_INIT_DATA_TTL_SECONDS=86400
TELEGRAM_PAYMENT_PROVIDER_TOKEN=CHANGE_ME
# Secret token for POST /api/payments/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
# Internal token the bot uses to forward payment updates
# and to authenticate against /api/admin/bot/* (X-Service-Token)
SERVICE_TOKEN=CHANGE_ME

# --- URLs -----------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000

# --- Access control -------------------------------------------------------
# Comma-separated Telegram ids that receive the ADMIN role (server-side only).
# The same list authorises the internal Telegram admin panel: the bot sends
# X-Admin-Telegram-Id and the backend verifies it against this list.
ADMIN_TELEGRAM_IDS=
# Development login endpoint. Must be false in production.
ALLOW_DEV_LOGIN=true

# --- Economy --------------------------------------------------------------
DEFAULT_DAILY_ROLLS=10
PREMIUM_DAILY_ROLLS=25
DAILY_BASE_COINS=0
DAILY_STREAK_BONUS_COINS=25
REFERRAL_REWARD_COINS=250
REFERRAL_REWARD_ROLLS=3
MAX_REFERRALS_PER_DAY=20

# --- Rate limiting (requests per window) ----------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_ROLL=30
RATE_LIMIT_AUTH=60
RATE_LIMIT_REFERRAL=10
RATE_LIMIT_PAYMENT=10
RATE_LIMIT_ADMIN=60
# Buckets for the internal control surfaces (Telegram admin panel)
RATE_LIMIT_ADMIN_BOT=120
RATE_LIMIT_ADMIN_READ=240

# --- Payments -------------------------------------------------------------
# mock locally, telegram_stars in production
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=XTR

# --- Optional overrides ---------------------------------------------------
# RARITY_WEIGHTS_OVERRIDE={"COMMON":70,"UNCOMMON":20,"RARE":7,"EPIC":2,"LEGENDARY":0.8,"MYTHIC":0.19,"SECRET":0.01}

# --- Docker / PostgreSQL --------------------------------------------------
POSTGRES_DB=miniapp
POSTGRES_USER=miniapp
POSTGRES_PASSWORD=CHANGE_ME
